	local function applySearch()
		if not current then return end
		local q = search.Text:lower()
		for _, c in ipairs(current.Cards) do
			local titleMatch = q == "" or c.Title:lower():find(q, 1, true) ~= nil
			local any = false
			for _, it in ipairs(c.Items) do
				local m = titleMatch or it.Name:find(q, 1, true) ~= nil
				it.Row.Visible = m
				if m then any = true end
			end
			c.Frame.Visible = any or #c.Items == 0
		end
	end
	connect(search:GetPropertyChangedSignal("Text"), applySearch)

	local function setActive(t, on)
		local active = (on == true)
		if active then
			t.root.Visible = true
			t.root.Position = UDim2.fromOffset(0, 16)
			t.root.GroupTransparency = 1
			tween(t.root, 0.35, { Position = UDim2.fromOffset(0, 0), GroupTransparency = 0 }, Enum.EasingStyle.Quint)
			t.icon:TweenColor(Theme.Accent, 0.2)
			t.tx.TextColor3 = WHITE
			t.tx.Font = Enum.Font.GothamBold
			t.iconHost.Rotation = -14
			tween(t.iconHost, 0.4, { Rotation = 0 }, Enum.EasingStyle.Back)
			t.underline.Size = UDim2.fromOffset(0, 3)
			tween(t.underline, 0.5, { Size = UDim2.fromOffset(34, 3) }, Enum.EasingStyle.Quint)
		else
			t.root.Visible = false
			t.icon:TweenColor(Theme.Sub, 0.2)
			t.tx.TextColor3 = Theme.Sub
			t.tx.Font = Enum.Font.GothamMedium
		end
	end
	local function selectTab(t)
		if current == t then return end
		local first = (current == nil)
		if current then setActive(current, false) end
		current = t
		setActive(t, true)
		local y = (t.index - 1) * (TAB_H + TAB_GAP)
		if first then
			ind.Position = UDim2.fromOffset(0, y)
			ind.Visible = true
		else
			tween(ind, 0.38, { Position = UDim2.fromOffset(0, y) }, Enum.EasingStyle.Quint)
			indBar.Size = UDim2.fromOffset(3, 28)
			tween(indBar, 0.4, { Size = UDim2.fromOffset(3, 18) }, Enum.EasingStyle.Back)
		end
		search.Text = ""
		applySearch()
	end

