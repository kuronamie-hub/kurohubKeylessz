-- ICONS
----------------------------------------------------------------------
local function Icon(kind, parent, size, color)
	size = size or 20
	color = color or Theme.Sub
	local s = size / 20
	local holder = new("Frame", {
		Size = UDim2.fromOffset(size, size), BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
	}, parent)
	local parts = {}

	local function bar(cx, cy, w, h, rot)
		local f = new("Frame", {
			Size = UDim2.fromOffset(w * s, h * s), AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromOffset(cx * s, cy * s), Rotation = rot or 0, BackgroundColor3 = color,
		}, holder)
		corner(f, math.min(w, h) * s / 2)
		parts[#parts + 1] = { f, "bg" }
		return f
	end
	local function ring(x, y, d, th)
		local f = new("Frame", {
			Size = UDim2.fromOffset(d * s, d * s), Position = UDim2.fromOffset(x * s, y * s), BackgroundTransparency = 1,
		}, holder)
		corner(f, d * s / 2)
		local st = stroke(f, color, math.max(1, th * s))
		parts[#parts + 1] = { st, "stroke" }
		return f
	end

	if kind == "info" then
		ring(1, 1, 18, 2)
		bar(10, 6, 2.4, 2.4)
		bar(10, 11.5, 2, 6)
	elseif kind == "chevrons" then
		bar(8.5, 6.5, 2.2, 8, -45); bar(8.5, 13.5, 2.2, 8, 45)
		bar(13.5, 6.5, 2.2, 8, -45); bar(13.5, 13.5, 2.2, 8, 45)
	elseif kind == "tower" then
		bar(10, 4, 6, 3); bar(10, 9.5, 10, 3); bar(10, 15, 15, 3)
	elseif kind == "up" then
		bar(10, 11.5, 2.4, 11); bar(7, 6.5, 2.2, 8, 45); bar(13, 6.5, 2.2, 8, -45)
	elseif kind == "flask" then
		bar(10, 6, 5, 9); bar(10, 2.5, 9, 2)
		local b = new("Frame", {
			Size = UDim2.fromOffset(14 * s, 14 * s), Position = UDim2.fromOffset(3 * s, 5 * s), BackgroundColor3 = color,
		}, holder)
		corner(b, 7 * s)
		parts[#parts + 1] = { b, "bg" }
	elseif kind == "coin" then
		ring(1, 1, 18, 2)
		local t = mkLabel({
			Text = "$", Font = Enum.Font.GothamBlack, TextSize = math.max(8, math.floor(11 * s)),
			TextColor3 = color, Size = UDim2.fromScale(1, 1),
		}, holder)
		parts[#parts + 1] = { t, "text" }
	elseif kind == "sliders" then
		bar(10, 4, 16, 2); bar(10, 10, 16, 2); bar(10, 16, 16, 2)
		bar(13, 4, 6, 6); bar(6, 10, 6, 6); bar(12, 16, 6, 6)
	elseif kind == "search" then
		ring(2, 2, 12, 2)
		bar(15.5, 15.5, 2.2, 6, -45)
	elseif kind == "chev" then
		bar(6.5, 9, 2.2, 9, -45); bar(13.5, 9, 2.2, 9, 45)
	elseif kind == "min" then
		bar(10, 10, 14, 2)
	else
		bar(10, 10, 6, 6)
	end

	local obj = { Frame = holder }
	function obj:SetColor(c)
		for _, p in ipairs(parts) do
			local inst, k = p[1], p[2]
			if k == "bg" then inst.BackgroundColor3 = c
			elseif k == "stroke" then inst.Color = c
			elseif k == "text" then inst.TextColor3 = c end
		end
	end
	function obj:TweenColor(c, t)
		for _, p in ipairs(parts) do
			local inst, k = p[1], p[2]
			if k == "bg" then tween(inst, t or 0.18, { BackgroundColor3 = c })
			elseif k == "stroke" then tween(inst, t or 0.18, { Color = c })
			elseif k == "text" then tween(inst, t or 0.18, { TextColor3 = c }) end
		end
	end
	return obj
end

