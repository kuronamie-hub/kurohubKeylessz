				local bar = new("Frame", { Size = UDim2.new(1, 0, 0, 6), Position = UDim2.fromOffset(0, 40), BackgroundColor3 = Theme.Off }, r)
				corner(bar, 3)
				local fill = new("Frame", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = Theme.Accent }, bar)
				corner(fill, 3)
				gradient(fill, Theme.Accent, Theme.AccentDeep, 0)
				local knob = new("Frame", { Size = UDim2.fromOffset(14, 14), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0, 0, 0.5, 0), BackgroundColor3 = WHITE }, bar)
