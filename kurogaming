				corner(boxF, 8)
				local bst = stroke(boxF, Theme.Stroke)
				local tb = new("TextBox", {
					Size = UDim2.new(1, -20, 1, 0), Position = UDim2.fromOffset(10, 0), BackgroundTransparency = 1,
					Text = tostring(o.Default or ""), PlaceholderText = o.Placeholder or "", PlaceholderColor3 = Theme.Muted,
					TextColor3 = Theme.Text, Font = Enum.Font.GothamMedium, TextSize = 11, TextXAlignment = LEFT, ClearTextOnFocus = false,
				}, boxF)
