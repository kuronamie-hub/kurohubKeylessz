				function obj:Set(v, silent)
					tb.Text = tostring(v or "")
					obj.Value = tb.Text
					if silent ~= true then
						fire(o.Callback, obj.Value)
						changed()
					end
				end
				connect(tb.FocusLost, function()
					tween(bst, 0.2, { Color = Theme.Stroke })
					obj:Set(tb.Text)
				end)
				if o.Flag then Flags[o.Flag] = obj end
				reg(r, o.Name)
				return obj
			end

			function card:Dropdown(o)
				local multi = (o.Multi == true)
				local options = o.Options or {}
				local sel, single = {}, nil
				local obj = { Value = (multi and {}) or nil }
				local buttons = {}
				local panelH, panelOpen = 0, false

				local box = new("Frame", {
					Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
					BackgroundTransparency = 1, LayoutOrder = nextOrder(),
				}, cbody)
				list(box, 0)

				local dh = new("Frame", { Size = UDim2.new(1, 0, 0, 48), BackgroundTransparency = 1, LayoutOrder = 1 }, box)
				mkLabel({ Text = o.Name, Size = UDim2.new(0.45, 0, 1, 0), TextXAlignment = LEFT, TextTruncate = Enum.TextTruncate.AtEnd }, dh)

				local selBtn = new("TextButton", {
					Text = "", Size = UDim2.new(0.55, 0, 0, 34), AnchorPoint = Vector2.new(1, 0.5),
					Position = UDim2.new(1, 0, 0.5, 0), BackgroundColor3 = Theme.Row,
				}, dh)
				corner(selBtn, 8)
				local sst = stroke(selBtn, Theme.Stroke)

				local valLbl = mkLabel({
					Size = UDim2.new(1, -34, 1, 0), Position = UDim2.fromOffset(12, 0), TextXAlignment = LEFT,
					TextTruncate = Enum.TextTruncate.AtEnd, TextSize = 10, TextColor3 = Theme.Sub,
				}, selBtn)

				local arrow = Icon("chev", selBtn, 12, Theme.Sub)
				arrow.Frame.Position = UDim2.new(1, -16, 0.5, 0)

				local panel = new("ScrollingFrame", {
					Size = UDim2.new(1, 0, 0, 0), BackgroundColor3 = Theme.Row, ScrollBarThickness = 3,
					ScrollBarImageColor3 = Theme.Muted, AutomaticCanvasSize = Enum.AutomaticSize.Y,
					CanvasSize = UDim2.new(), Visible = false, LayoutOrder = 2,
					ScrollingDirection = Enum.ScrollingDirection.Y,
				}, box)
				corner(panel, 8)
				local pl = list(panel, 2)
				pl.HorizontalAlignment = Enum.HorizontalAlignment.Center

				new("Frame", { Size = UDim2.new(1, 0, 0, 2), BackgroundTransparency = 1, LayoutOrder = 0 }, panel)
				new("Frame", {
					Size = UDim2.new(1, 0, 0, 1), BackgroundColor3 = Theme.Stroke,
					BackgroundTransparency = 0.35, LayoutOrder = 3,
				}, box)

				local function setPanel(v)
					local open = (v == true)
					panelOpen = open
					tween(arrow.Frame, 0.25, { Rotation = open and 180 or 0 }, Enum.EasingStyle.Back)
					tween(sst, 0.15, { Color = open and Theme.Accent or Theme.Stroke })
					if open then
						panel.Visible = true
						panel.Size = UDim2.new(1, 0, 0, 0)
						tween(panel, 0.28, { Size = UDim2.new(1, 0, 0, panelH) }, Enum.EasingStyle.Quint)
					else
						local tw = tween(panel, 0.2, { Size = UDim2.new(1, 0, 0, 0) }, Enum.EasingStyle.Quint)
						tw.Completed:Connect(function()
							if panelOpen == false then
								panel.Visible = false
							end
						end)
					end
				end

				local function selectedValue()
					if multi == false then return single end
					local arr, seen = {}, {}
					for _, n in ipairs(options) do
						if sel[n] == true then
							arr[#arr + 1] = n
							seen[n] = true
						end
					end
					for n in pairs(sel) do
						if seen[n] ~= true then
							arr[#arr + 1] = n
						end
					end
					return arr
				end

				local function refreshHead()
					if multi == true then
						local n = 0
						for _ in pairs(sel) do n += 1 end
						valLbl.Text = (n > 0) and (n .. " selected") or "None selected"
						valLbl.TextColor3 = (n > 0) and Theme.Text or Theme.Sub
					else
						valLbl.Text = single and tostring(single) or "None selected"
						valLbl.TextColor3 = single and Theme.Text or Theme.Sub
					end
				end

				local function paint()
					for name, b in pairs(buttons) do
						local on
						if multi == true then
							on = (sel[name] == true)
						else
							on = (single == name)
						end
						tween(b.txt, 0.15, { TextColor3 = on and Theme.Accent or Theme.Text })
						b.chk.Visible = on
					end
				end

				local function commit(silent)
					obj.Value = selectedValue()
					refreshHead()
					paint()
					if silent ~= true then
						fire(o.Callback, obj.Value)
						changed()
					end
				end

				local function pick(name)
					if multi == true then
						if sel[name] == true then
							sel[name] = nil
						else
							sel[name] = true
						end
					else
						single = name
						setPanel(false)
					end
					commit()
				end

				local function rebuild()
					for _, b in pairs(buttons) do b.btn:Destroy() end
					buttons = {}
					for i, name in ipairs(options) do
						local b = new("TextButton", {
							Text = "", Size = UDim2.new(1, -8, 0, 26),
							BackgroundColor3 = Theme.RowHi, BackgroundTransparency = 1, LayoutOrder = i,
						}, panel)
						corner(b, 6)
						local t = mkLabel({
							Text = tostring(name), Size = UDim2.new(1, -28, 1, 0),
							Position = UDim2.fromOffset(8, 0), TextXAlignment = LEFT,
							TextTruncate = Enum.TextTruncate.AtEnd, TextSize = 11,
						}, b)
						local c = mkLabel({
							Text = "✓", Font = Enum.Font.GothamBold, Size = UDim2.fromOffset(18, 26),
							Position = UDim2.new(1, -22, 0, 0), TextColor3 = Theme.Accent, TextSize = 12,
						}, b)
						buttons[name] = { btn = b, txt = t, chk = c }
						b.MouseEnter:Connect(function() tween(b, 0.1, { BackgroundTransparency = 0 }) end)
						b.MouseLeave:Connect(function() tween(b, 0.1, { BackgroundTransparency = 1 }) end)
						b.MouseButton1Click:Connect(function() pick(name) end)
					end
					panelH = math.min(#options * 28 + 8, 160)
					if panelOpen == true then
						panel.Size = UDim2.new(1, 0, 0, panelH)
					end
					paint()
				end

				if multi == true then
					for _, n in ipairs(o.Default or {}) do
						sel[tostring(n)] = true
					end
				else
					local d = o.Default
					if type(d) == "table" then d = d[1] end
					single = (d ~= nil) and tostring(d) or nil
				end
				obj.Value = selectedValue()
				refreshHead()
				rebuild()

				function obj:Set(v, silent)
					if multi == true then
						sel = {}
						if type(v) == "table" then
							for _, n in ipairs(v) do
								sel[tostring(n)] = true
							end
						elseif type(v) == "string" then
							sel[v] = true
						end
					else
						if type(v) == "table" then v = v[1] end
						single = (v ~= nil) and tostring(v) or nil
					end
					commit(silent)
				end

				function obj:Refresh(newOptions)
					options = newOptions or {}
					rebuild()
				end

				connect(selBtn.MouseButton1Click, function() setPanel(panelOpen == false) end)
				if o.Flag then Flags[o.Flag] = obj end
				reg(box, o.Name)
				return obj
			end

			return card
		end

		if not current then selectTab(tab) end
		return tab
	end

	function W:LoadConfig()
		if not canFile then return end
		local ok, data = pcall(function()
			local path = cfg.Folder .. "/" .. cfg.File
			if isfile(path) then return HttpService:JSONDecode(readfile(path)) end
		end)
		if not ok or type(data) ~= "table" then return end
		loading = true
		for flag, val in pairs(data) do
			local o = Flags[flag]
			if o then pcall(o.Set, o, val) end
		end
		loading = false
	end

	function W:Destroy()
		for _, c in ipairs(Conns) do pcall(function() c:Disconnect() end) end
		pcall(function() blur:Destroy() end)
		pcall(function() gui:Destroy() end)
	end

	task.defer(function() setOpen(true) end)

	return W
end

