				stroke(knob, Theme.Accent, 2)
				local hit = new("TextButton", { Text = "", Size = UDim2.new(1, 0, 0, 28), Position = UDim2.fromOffset(0, 29), BackgroundTransparency = 1 }, r)
				local obj = { Value = math.clamp(o.Default or min, min, max) }
				local function render()
					local rel = max > min and (obj.Value - min) / (max - min) or 0
					tween(fill, 0.08, { Size = UDim2.fromScale(rel, 1) })
					tween(knob, 0.08, { Position = UDim2.new(rel, 0, 0.5, 0) })
					val.Text = tostring(obj.Value) .. (o.Suffix and (" " .. o.Suffix) or "")
				end
				render()
				local function apply(v, silent, force)
					v = tonumber(v) or min
					v = math.clamp(math.floor((v - min) / step + 0.5) * step + min, min, max)
					local ch = v ~= obj.Value
					obj.Value = v
					render()
					local skip = (silent == true)
					local forceIt = (force == true)
					if (ch or forceIt) and not skip then
						fire(o.Callback, v)
						changed()
					end
				end
				function obj:Set(v, silent) apply(v, silent, true) end
				local dragging = false
				local function fromX(x)
					local rel = math.clamp((x - bar.AbsolutePosition.X) / math.max(bar.AbsoluteSize.X, 1), 0, 1)
					apply(min + rel * (max - min))
				end
				connect(hit.MouseEnter, function() tween(knob, 0.15, { Size = UDim2.fromOffset(18, 18) }, Enum.EasingStyle.Back) end)
				connect(hit.MouseLeave, function()
					if not dragging then tween(knob, 0.15, { Size = UDim2.fromOffset(14, 14) }) end
				end)
				connect(hit.InputBegan, function(i)
					if isPress(i) then
