								page.ScrollingEnabled = true
								tween(knob, 0.2, { Size = UDim2.fromOffset(14, 14) })
								c:Disconnect()
							end
						end)
					end
				end)
				connect(UIS.InputChanged, function(i)
					if dragging and isMove(i) then fromX(i.Position.X) end
				end)
				if o.Flag then Flags[o.Flag] = obj end
				reg(r, o.Name)
				return obj
			end

			function card:Input(o)
				local r = mkRow(72)
				mkLabel({ Text = o.Name, Size = UDim2.new(1, 0, 0, 16), Position = UDim2.fromOffset(0, 10), TextXAlignment = LEFT, TextTruncate = Enum.TextTruncate.AtEnd }, r)
