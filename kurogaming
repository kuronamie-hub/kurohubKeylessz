local sellCard = SellTab:Card("Auto Sell")

local sellMinRarity = "Common"
local sellMutation = false
local sellInterval = 20

local function sellInventory()
	local Reg = getModule("Inventory.EntryRegistry")
	local Rar = getModule("Other.Rarities", Framework)
	local inv = getData("Inventory")
	if not Reg or not Rar or type(inv) ~= "table" then return 0 end

	local okMin, minOrder = pcall(function() return Rar.Get(sellMinRarity).sortOrder end)
	minOrder = okMin and minOrder or 0

	local ids = {}
	for id, item in pairs(inv) do
		local cfg = entryConfig(item.name)
		if cfg and cfg.kind == "Unit" then
			local okR, order = pcall(function() return Rar.Get(cfg.getRarity(item.attributes or {})).sortOrder end)
			if okR and order <= minOrder then
				local mut = item.attributes and item.attributes.mutation
				if not sellMutation or mut then
					ids[#ids + 1] = id
				end
			end
		end
	end
	if #ids > 0 then
		pcall(function() Remotes.SellInventory:FireServer(ids) end)
	end
	return #ids
end

local sellLoop = newLoop("Auto Sell", function()
	sellInventory()
	return sellInterval
end, 20)

